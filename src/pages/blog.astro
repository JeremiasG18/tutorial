---
import BlogPost from "../components/BlogPost.astro";
import BaseLayout from "../layouts/BaseLayout.astro"; // importo la plantilla base
const pageTitle = 'My Astro Learning Blog'; // defino el titulo de mi pagina

const allPosts = Object.values(import.meta.glob('./posts/*.md', {eager: true}));
---

<BaseLayout pageTitle={pageTitle}>
    <p>This is where I will post about my journey learning Astro.</p>
    <ul>
        <!-- <li><a href="/posts/post-1/">Post 1</a></li>
        <li><a href="/posts/post-2/">Post 2</a></li>
        <li><a href="/posts/post-3/">Post 3</a></li> -->

        <!-- en lugar de hacer esto ⬆⬆⬆, hacemos esto ⬇⬇⬇ -->

        <!-- {allPosts.map((post: any) => <li><a href={post.url}>{post.frontmatter.title}</a></li>)} -->

        <!-- usando un componente para renderizar enlaces de las publicaciones -->
        {allPosts.map((post: any) => <BlogPost url={post.url} title={post.frontmatter.title} />)}

    </ul>
</BaseLayout>